#!/usr/bin/env bash
# cygnet: connect to FortiGate VPNs that ask for a one-time code, over IPsec or SSL.
#
#   cygnet [connect] [NAME]   prompt for the password, then for the code once it is sent
#   cygnet disconnect         take the tunnel down
#   cygnet status             show the tunnel state
#   cygnet list               list your connections
#   cygnet add                add a connection
#   cygnet edit NAME          change a connection
#   cygnet remove NAME        delete a connection
#
# NAME is a connection's name or id. It can be left out when there's only one connection.
# One connection can be up at a time.
#
# A connection is IPsec (IKEv2, through the patched charon) or SSL (through openfortivpn).
# Its settings are in $CONN_DIR/<id>.conf, which is readable by everyone so the GUI can
# list it. Its secrets are readable only by root: <id>.psk holds an IPsec connection's
# pre-shared key, and <id>.password an SSL connection's password, if you chose to save it.
#
# IPsec: only the connection in use is loaded into charon, as $SWAN_CONF. The gateway only
# sends the code after accepting the password, inside one IKE exchange. charon runs
# otp-helper at that point, which blocks on a FIFO that this script feeds.
#
# SSL: openfortivpn runs as $SSL_SERVICE and asks ssl-pinentry for the password and code,
# which blocks on a FIFO that this script feeds in the same way. A gateway certificate that
# the system doesn't trust is shown once, and remembered if you trust it.
#
# The code is never written to disk, and neither is the password unless you save it for an
# SSL connection. Neither is passed on a command line.
#
# With --ui, this talks to the Cygnet GUI instead of a terminal: it prints one event per
# line on stdout and reads the password, code and answers as lines on stdin. Closing stdin
# cancels.
set -eu
umask 077

PREFIX=/opt/cygnet
SWANCTL=$PREFIX/sbin/swanctl
CONN_DIR=$PREFIX/etc/connections
SERVICE=cygnet.service
CONN=fortigate # swanctl's name for whichever connection is in use

RUN_DIR=/run/cygnet # root-only tmpfs, created by the service
SWAN_CONF=$RUN_DIR/swanctl.conf
FIFO=$RUN_DIR/otp.fifo
REQUEST=$RUN_DIR/otp.request
LOG=$RUN_DIR/initiate.log
# The id of the connected connection, readable by the GUI. For SSL, its interface follows on
# a second line.
ACTIVE=/run/cygnet.active

SSL_SERVICE=cygnet-ssl.service
SSL_DIR=/run/cygnet-ssl # root-only, created by this script
SSL_CONF=$SSL_DIR/openfortivpn.conf
SSL_FIFO=$SSL_DIR/secret.fifo
SSL_REQUEST=$SSL_DIR/request
DEFAULT_SSL_PORT=443

DEFAULT_IKE_PROPOSALS=aes256-sha256-modp2048
# The key exchange group in an ESP proposal is only used when the tunnel is rekeyed, hours
# after connecting. A gateway with perfect forward secrecy, FortiGate's default, refuses a
# rekey without one; the second proposal is for gateways that have it turned off.
DEFAULT_ESP_PROPOSALS=aes256-sha256-modp2048,aes256-sha256

# Longer than the helper's own wait, so the helper always gives up first.
INITIATE_TIMEOUT=300
CODE_PROMPT_TIMEOUT=240
# After the gateway rejects a code, how long cygnet goes on signing in again for new codes
# with the password it already has, before you have to enter the password again.
CODE_RETRY_SECONDS=120

ui=
creds=
init_pid=
fifo_open=
connected=

# --- Output ------------------------------------------------------------------------------

event() { if [[ -n $ui ]]; then printf '%s\n' "$*"; fi; }
say() { if [[ -z $ui ]]; then printf '%s\n' "$*"; fi; }

die() {
    if [[ -n $ui ]]; then
        printf '%s\n' "$*" | sed 's/^/error /'
    else
        echo "cygnet: $*" >&2
    fi
    exit 1
}

# --- Connections -------------------------------------------------------------------------

trim() {
    local v=$1
    v=${v#"${v%%[![:space:]]*}"}
    printf %s "${v%"${v##*[![:space:]]}"}"
}

# The value of KEY in a connection file. Files are parsed, never sourced.
conf_get() {
    local file=$1 key=$2 line
    while IFS= read -r line; do
        if [[ $line =~ ^[[:space:]]*$key[[:space:]]*=(.*)$ ]]; then
            trim "${BASH_REMATCH[1]}"
            return
        fi
    done <"$file"
}

conn_ids() {
    local f
    for f in "$CONN_DIR"/*.conf; do
        [[ -e $f ]] || continue
        f=${f##*/}
        echo "${f%.conf}"
    done
}

# Sets the c_ values from connection $1: c_type (ipsec or ssl), c_name, c_gateway and
# c_username, then c_networks, c_ike and c_esp for IPsec, or c_port, c_save_password (yes or
# no) and c_trusted_cert for SSL. A connection without a type is IPsec, as all were once.
load_conn() {
    local f=$CONN_DIR/$1.conf
    [[ -r $f ]] || die "no connection with id $1"
    c_type=$(conf_get "$f" type)
    [[ $c_type == ssl ]] || c_type=ipsec
    c_name=$(conf_get "$f" name)
    c_gateway=$(conf_get "$f" gateway)
    c_username=$(conf_get "$f" username)
    c_networks=$(conf_get "$f" networks)
    c_ike=$(conf_get "$f" ike_proposals)
    c_esp=$(conf_get "$f" esp_proposals)
    c_ike=${c_ike:-$DEFAULT_IKE_PROPOSALS}
    c_esp=${c_esp:-$DEFAULT_ESP_PROPOSALS}
    c_port=$(conf_get "$f" port)
    c_port=${c_port:-$DEFAULT_SSL_PORT}
    c_save_password=$(conf_get "$f" save_password)
    [[ $c_save_password == yes ]] || c_save_password=no
    c_trusted_cert=$(conf_get "$f" trusted_cert)
}

# Sets id to the connection called $1 (a name or an id), or to the only one if $1 is empty.
pick() {
    local want=$1 ids n i
    mapfile -t ids < <(conn_ids)
    if [[ -n $want ]]; then
        for id in "${ids[@]}"; do
            [[ $id != "$want" ]] || return 0
        done
        for id in "${ids[@]}"; do
            n=$(conf_get "$CONN_DIR/$id.conf" name)
            [[ ${n,,} != "${want,,}" ]] || return 0
        done
        die "there's no connection called $want (see: cygnet list)"
    fi
    case ${#ids[@]} in
    0) die "there are no connections yet; add one with: cygnet add" ;;
    1) id=${ids[0]} ;;
    *)
        [[ -z $ui ]] || die "there are several connections, so name one"
        for i in "${!ids[@]}"; do
            printf '%d) %s\n' $((i + 1)) "$(conf_get "$CONN_DIR/${ids[i]}.conf" name)"
        done
        while :; do
            read -rp "Which one? " n
            if [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#ids[@]})); then
                id=${ids[n - 1]}
                return
            fi
        done
        ;;
    esac
}

new_id() {
    local base n=2
    base=$(printf %s "${1,,}" | tr -cs 'a-z0-9' - | sed 's/^-*//; s/-*$//' | cut -c1-32)
    base=${base:-vpn}
    id=$base
    while [[ -e $CONN_DIR/$id.conf ]]; do
        id=$base-$n
        n=$((n + 1))
    done
}

# Validators: each prints the cleaned-up value, or explains the problem on stderr.
check_name() {
    [[ -n $1 && ${#1} -le 256 && $1 =~ ^[^[:cntrl:]]+$ ]] && printf %s "$1" && return
    echo "Give the connection a name." >&2
    return 1
}
check_gateway() {
    [[ $1 =~ ^[A-Za-z0-9.:-]{1,253}$ ]] && printf %s "$1" && return
    echo "The gateway is an IP address or hostname, such as vpn.example.com." >&2
    return 1
}
# openfortivpn only looks up IPv4 addresses, and the address can't carry a port.
check_ssl_gateway() {
    [[ $1 =~ ^[A-Za-z0-9.-]{1,253}$ ]] && printf %s "$1" && return
    echo "The gateway is an IPv4 address or hostname, such as vpn.example.com, without a port." >&2
    return 1
}
check_port() {
    [[ $1 =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)) && printf %d "$((10#$1))" && return
    echo "The port is a number from 1 to 65535, often 443 or 10443." >&2
    return 1
}
check_username() {
    [[ ${#1} -le 256 && $1 =~ ^[^[:cntrl:][:space:]]+$ ]] && printf %s "$1" && return
    echo "The username can't be empty or contain spaces." >&2
    return 1
}
check_networks() {
    local v=${1//[[:space:]]/} net out= i
    local -a nets
    IFS=, read -ra nets <<<"$v"
    for net in "${nets[@]}"; do
        [[ -n $net ]] || continue
        if [[ $net =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})(/([0-9]{1,2}))?$ ]]; then
            for i in 1 2 3 4; do
                ((10#${BASH_REMATCH[i]} <= 255)) || net=
            done
            [[ -z ${BASH_REMATCH[6]} ]] || ((10#${BASH_REMATCH[6]} <= 32)) || net=
        else
            net=
        fi
        if [[ -z $net ]]; then
            echo "List networks like 10.1.0.0/16, 10.2.3.4/32, separated by commas." >&2
            return 1
        fi
        out+=${out:+, }$net
    done
    [[ -n $out ]] && printf %s "$out" && return
    echo "List at least one network, such as 10.1.0.0/16. Use 0.0.0.0/0 for everything." >&2
    return 1
}
check_proposals() {
    local v=${1//[[:space:]]/}
    [[ $v =~ ^[a-z0-9_-]+(,[a-z0-9_-]+)*$ ]] && printf %s "$v" && return
    echo "Proposals look like aes256-sha256-modp2048, separated by commas." >&2
    return 1
}
# openfortivpn takes passwords of up to 256 bytes. A line break would end it early.
check_password() {
    [[ -n $1 && ${#1} -le 256 && $1 =~ ^[^[:cntrl:]]+$ ]] && printf %s "$1" && return
    echo "Enter the VPN password: up to 256 characters, without line breaks." >&2
    return 1
}
check_yes_no() {
    case ${1,,} in
    y | yes) echo yes ;;
    n | no) echo no ;;
    *)
        echo "Answer yes or no." >&2
        return 1
        ;;
    esac
}
check_type() {
    case ${1,,} in
    1 | ipsec) echo ipsec ;;
    2 | ssl) echo ssl ;;
    *)
        echo "Answer 1 for IPsec or 2 for SSL VPN." >&2
        return 1
        ;;
    esac
}
check_psk() {
    [[ -n $1 && ${#1} -le 1024 && $1 =~ ^[^[:cntrl:]]+$ ]] && printf %s "$1" && return
    echo "Enter the gateway's pre-shared key." >&2
    return 1
}

# Writes SECRET to the root-only file FILE, replacing it whole.
write_secret() {
    local tmp
    tmp=$(mktemp -p "$CONN_DIR" .new.XXXXXX)
    printf %s "$2" >"$tmp"
    mv "$tmp" "$1"
}

# Writes connection $id from the c_ values. c_psk, and c_password, may be empty to keep the
# current one. An SSL connection whose password isn't to be saved loses any saved one.
write_conn() {
    local tmp other
    while read -r other; do
        if [[ $other != "$id" && $(conf_get "$CONN_DIR/$other.conf" name | tr '[:upper:]' '[:lower:]') == $(printf %s "$c_name" | tr '[:upper:]' '[:lower:]') ]]; then
            die "there's already a connection called $c_name"
        fi
    done < <(conn_ids)
    install -d -m 755 "$CONN_DIR"
    if [[ $c_type == ssl ]]; then
        if [[ $c_save_password == yes ]]; then
            [[ -z $c_password ]] || write_secret "$CONN_DIR/$id.password" "$c_password"
        else
            rm -f "$CONN_DIR/$id.password"
        fi
    else
        [[ -z $c_psk ]] || write_secret "$CONN_DIR/$id.psk" "$c_psk"
        [[ -e $CONN_DIR/$id.psk ]] || die "a pre-shared key is needed"
    fi
    tmp=$(mktemp -p "$CONN_DIR" .new.XXXXXX)
    if [[ $c_type == ssl ]]; then
        cat >"$tmp" <<EOF
# Cygnet connection. Change it with the Cygnet app or: cygnet edit $id
# A saved password is in $id.password.
type = ssl
name = $c_name
gateway = $c_gateway
port = $c_port
username = $c_username
save_password = $c_save_password
trusted_cert = $c_trusted_cert
EOF
    else
        cat >"$tmp" <<EOF
# Cygnet connection. Change it with the Cygnet app or: cygnet edit $id
# The pre-shared key is in $id.psk.
type = ipsec
name = $c_name
gateway = $c_gateway
username = $c_username
networks = $c_networks
ike_proposals = $c_ike
esp_proposals = $c_esp
EOF
    fi
    chmod 644 "$tmp"
    mv "$tmp" "$CONN_DIR/$id.conf"
}

has_saved_password() {
    [[ $c_type == ssl && $c_save_password == yes && -s $CONN_DIR/$1.password ]]
}

# Asks for a value in the terminal until VALIDATOR accepts it. An empty answer keeps DEFAULT.
ask() {
    local var=$1 prompt=$2 default=$3 check=$4 v
    while :; do
        read -rp "$prompt${default:+ [$default]}: " v
        v=$(trim "$v")
        v=${v:-$default}
        if v=$("$check" "$v"); then
            printf -v "$var" %s "$v"
            return
        fi
    done
}

ask_psk() {
    local keep=$1 v
    while :; do
        IFS= read -rsp "Pre-shared key${keep:+ (Enter keeps the current one)}: " v
        echo
        if [[ -z $v && -n $keep ]]; then
            c_psk=
            return
        fi
        if v=$(check_psk "$v"); then
            c_psk=$v
            return
        fi
    done
}

# Asks whether to save the password of an SSL connection, and for the password if so.
# Leaving it empty keeps a saved one, or with none saved, asks for it when you next connect
# and saves it once the gateway accepts it.
ask_save_password() {
    local saved=$1 v
    ask c_save_password "Save the password on this computer? (yes/no)" "$c_save_password" check_yes_no
    c_password=
    [[ $c_save_password == yes ]] || return 0
    while :; do
        IFS= read -rsp "Password (Enter ${saved:+keeps the saved one}${saved:-asks when you connect}): " v
        echo
        [[ -n $v ]] || return 0
        if v=$(check_password "$v"); then
            c_password=$v
            return
        fi
    done
}

add() {
    local id
    echo "What kind of VPN is it?"
    echo "  1) IPsec (IKEv2): the gateway is set up with a pre-shared key"
    echo "  2) SSL VPN: openfortivpn, or FortiClient's SSL-VPN tab"
    ask c_type "Type" "" check_type
    echo "Your VPN admin can tell you these. Press Ctrl+C to cancel."
    ask c_name "Name, such as Head Office" "" check_name
    if [[ $c_type == ssl ]]; then
        ask c_gateway "Gateway address" "" check_ssl_gateway
        ask c_port "Port" "$DEFAULT_SSL_PORT" check_port
        ask c_username "Username" "" check_username
        c_save_password=no c_trusted_cert=
        ask_save_password ""
    else
        ask c_gateway "Gateway address" "" check_gateway
        ask c_username "Username" "" check_username
        ask_psk ""
        ask c_networks "Networks to send through the VPN, or 0.0.0.0/0 for everything" "" check_networks
        ask c_ike "IKE proposals" "$DEFAULT_IKE_PROPOSALS" check_proposals
        ask c_esp "ESP proposals" "$DEFAULT_ESP_PROPOSALS" check_proposals
    fi
    new_id "$c_name"
    write_conn
    echo "Added $c_name. Connect with: cygnet connect $id"
}

edit() {
    local id gateway port saved=
    pick "$1"
    load_conn "$id"
    echo "Press Enter to keep a value, or Ctrl+C to cancel."
    ask c_name "Name" "$c_name" check_name
    if [[ $c_type == ssl ]]; then
        gateway=$c_gateway port=$c_port
        ! has_saved_password "$id" || saved=1
        ask c_gateway "Gateway address" "$c_gateway" check_ssl_gateway
        ask c_port "Port" "$c_port" check_port
        ask c_username "Username" "$c_username" check_username
        ask_save_password "$saved"
        # A certificate trusted for one gateway says nothing about another.
        [[ $c_gateway == "$gateway" && $c_port == "$port" ]] || c_trusted_cert=
    else
        ask c_gateway "Gateway address" "$c_gateway" check_gateway
        ask c_username "Username" "$c_username" check_username
        ask_psk keep
        ask c_networks "Networks to send through the VPN" "$c_networks" check_networks
        ask c_ike "IKE proposals" "$c_ike" check_proposals
        ask c_esp "ESP proposals" "$c_esp" check_proposals
    fi
    write_conn
    echo "Saved. Changes apply the next time you connect."
}

# For the GUI: reads name=..., gateway=... lines on stdin and saves them as connection $1,
# or as a new connection if $1 is empty. A new connection's type=ipsec or type=ssl comes
# first; an existing one keeps its type. psk, or password, may be left out to keep the
# current one.
save() {
    local id=$1 line key value gateway port
    c_type=ipsec c_name= c_gateway= c_username= c_networks= c_psk= c_password=
    c_ike=$DEFAULT_IKE_PROPOSALS c_esp=$DEFAULT_ESP_PROPOSALS
    c_port=$DEFAULT_SSL_PORT c_save_password=no c_trusted_cert=
    if [[ -n $id ]]; then
        [[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid connection id"
        load_conn "$id"
    fi
    gateway=$c_gateway port=$c_port
    while IFS= read -r line; do
        key=${line%%=*}
        value=${line#*=}
        case $key in
        type)
            [[ -z $id ]] || continue
            c_type=$(check_type "$(trim "$value")" 2>&1) || die "$c_type"
            ;;
        name) c_name=$(check_name "$(trim "$value")" 2>&1) || die "$c_name" ;;
        gateway)
            if [[ $c_type == ssl ]]; then
                c_gateway=$(check_ssl_gateway "$(trim "$value")" 2>&1) || die "$c_gateway"
            else
                c_gateway=$(check_gateway "$(trim "$value")" 2>&1) || die "$c_gateway"
            fi
            ;;
        port) c_port=$(check_port "$(trim "$value")" 2>&1) || die "$c_port" ;;
        username) c_username=$(check_username "$(trim "$value")" 2>&1) || die "$c_username" ;;
        networks) c_networks=$(check_networks "$value" 2>&1) || die "$c_networks" ;;
        ike_proposals) c_ike=$(check_proposals "$value" 2>&1) || die "$c_ike" ;;
        esp_proposals) c_esp=$(check_proposals "$value" 2>&1) || die "$c_esp" ;;
        psk) [[ -z $value ]] || c_psk=$(check_psk "$value" 2>&1) || die "$c_psk" ;;
        save_password) c_save_password=$(check_yes_no "$(trim "$value")" 2>&1) || die "$c_save_password" ;;
        password) [[ -z $value ]] || c_password=$(check_password "$value" 2>&1) || die "$c_password" ;;
        esac
    done
    [[ -n $c_name && -n $c_gateway && -n $c_username ]] ||
        die "name, gateway and username are all needed"
    if [[ $c_type == ipsec ]]; then
        [[ -n $c_networks ]] || die "networks are needed"
    elif [[ $c_gateway != "$gateway" || $c_port != "$port" ]]; then
        c_trusted_cert=
    fi
    [[ -n $id ]] || new_id "$c_name"
    write_conn
    event "saved $id"
    say "Saved $c_name."
}

remove() {
    local id
    pick "$1"
    if [[ $(active_id) == "$id" ]] && any_up; then
        die "that connection is in use; disconnect first"
    fi
    load_conn "$id"
    rm -f "$CONN_DIR/$id.conf" "$CONN_DIR/$id.psk" "$CONN_DIR/$id.password"
    event removed
    say "Removed $c_name."
}

list() {
    local id active
    active=$(active_id)
    if [[ -z $(conn_ids) ]]; then
        echo "No connections yet. Add one with: cygnet add"
        return
    fi
    while read -r id; do
        load_conn "$id"
        printf '%s  %s\n' "$([[ $id == "$active" ]] && echo '*' || echo ' ')" "$c_name ($id)"
        if [[ $c_type == ssl ]]; then
            printf '    SSL VPN: %s at %s:%s, password %s\n' "$c_username" "$c_gateway" "$c_port" \
                "$([[ $c_save_password == yes ]] && echo saved || echo "asked each time")"
        else
            printf '    IPsec: %s at %s, networks %s\n' "$c_username" "$c_gateway" "$c_networks"
        fi
    done < <(conn_ids)
}

# Imports the vpn.conf of an earlier version: swanctl config with one connection. Only for
# install.sh.
import_legacy() {
    local file=$1 id
    [[ -z ${PKEXEC_UID:-} ]] || die "import only works from a terminal"
    [[ -r $file ]] || die "can't read $file"
    c_gateway=$(conf_get "$file" remote_addrs)
    c_username=$(conf_get "$file" eap_id)
    c_networks=$(conf_get "$file" remote_ts)
    c_ike=$(conf_get "$file" proposals)
    c_esp=$(conf_get "$file" esp_proposals)
    c_psk=$(conf_get "$file" secret)
    c_psk=${c_psk#\"}
    c_psk=${c_psk%\"}
    c_gateway=$(check_gateway "$c_gateway") &&
        c_username=$(check_username "$c_username") &&
        c_networks=$(check_networks "$c_networks") &&
        c_ike=$(check_proposals "${c_ike:-$DEFAULT_IKE_PROPOSALS}") &&
        c_esp=$(check_proposals "${c_esp:-$DEFAULT_ESP_PROPOSALS}") &&
        c_psk=$(check_psk "$c_psk") || die "couldn't import $file"
    c_type=ipsec c_name=$c_gateway
    new_id "$c_name"
    write_conn
    echo "Imported $file as the connection \"$c_name\"."
}

# --- Tunnel ------------------------------------------------------------------------------

active_id() {
    head -n 1 "$ACTIVE" 2>/dev/null || true
}

# Up means signed in to the gateway (the IKE SA) with a tunnel installed (its CHILD_SA).
# The sign-in alone doesn't count: it outlives the tunnel when the gateway closes that or a
# rekey fails, and goes on answering keepalives while no traffic can pass.
is_up() {
    systemctl is-active --quiet "$SERVICE" || return 1
    local nl=$'\n' sas
    sas=$nl$("$SWANCTL" --list-sas --ike "$CONN" 2>/dev/null) || return 1
    [[ $sas =~ "$nl$CONN: #"[0-9]+", "(ESTABLISHED|REKEYING)"," ]] &&
        [[ $sas =~ "$nl  $CONN: #"[0-9]+", reqid "[0-9]+", "(INSTALLED|REKEYING)"," ]]
}

# openfortivpn tells systemd it's ready once the tunnel is up, so "active" means connected.
ssl_is_up() {
    systemctl is-active --quiet "$SSL_SERVICE"
}

any_up() {
    is_up || ssl_is_up
}

# Also signs out of the gateway, if a sign-in is left without its tunnel.
drop_sa() {
    "$SWANCTL" --terminate --ike "$CONN" --force --timeout 5 >/dev/null 2>&1 || true
}

# Strings in swanctl config: backslashes and quotes are escaped.
quote() {
    local v=${1//\\/\\\\}
    printf '"%s"' "${v//\"/\\\"}"
}

hex() {
    od -An -v -tx1 | tr -d ' \n'
}

# swanctl config for the c_ connection $1, with its pre-shared key but not the password.
write_swanctl_conf() {
    local psk
    psk=$(hex <"$CONN_DIR/$1.psk")
    cat >"$SWAN_CONF" <<EOF
connections {
    $CONN {
        version = 2
        remote_addrs = $c_gateway
        local_addrs = %any
        vips = 0.0.0.0
        mobike = no
        proposals = $c_ike
        rekey_time = 86400s
        dpd_delay = 30s
        local-eap {
            auth = eap-mschapv2
            eap_id = $(quote "$c_username")
        }
        remote {
            auth = psk
        }
        children {
            $CONN {
                remote_ts = $c_networks
                local_ts = dynamic
                esp_proposals = $c_esp
                rekey_time = 43200s
                # Not restart: reconnecting needs a new code, so it has to be manual.
                dpd_action = clear
                start_action = none
            }
        }
    }
}
secrets {
    ike-$CONN {
        secret = 0x$psk
    }
}
EOF
}

# Hex-encoded so that no password character can break the config syntax. The connection's
# config is included because loading credentials unloads any that aren't in the file, which
# would otherwise drop the pre-shared key.
load_password() {
    local password=$1 output
    creds=$(mktemp -p "$RUN_DIR" creds.XXXXXX)
    cat >"$creds" <<EOF
include $SWAN_CONF
secrets {
    eap-$CONN {
        id = $(quote "$c_username")
        secret = 0x$(printf %s "$password" | hex)
    }
}
EOF
    output=$("$SWANCTL" --load-creds --clear --noprompt --file "$creds" 2>&1) ||
        die "charon refused the credentials: $output"
    rm -f "$creds"
}

# charon keeps running when it can't open its UDP sockets, and then drops every packet it
# sends, so connecting would only time out. The usual cause is another IPsec daemon that
# already has the IKE ports. A gateway given by name may resolve to either address family,
# so a socket of either family is enough for it.
check_sockets() {
    local pid sockets other name unit holders=
    local -a family=()
    pid=$(systemctl show --property MainPID --value "$SERVICE") || return 0
    [[ $pid =~ ^[1-9][0-9]*$ ]] || return 0
    case $c_gateway in
    *:*) family=(-6) ;;
    *[!0-9.]*) ;;
    *) family=(-4) ;;
    esac
    sockets=$(ss -Hlunp "${family[@]}" 2>/dev/null) || return 0
    [[ $sockets != *"pid=$pid,"* ]] || return 0

    while read -r other name; do
        [[ $other != "$pid" ]] || continue
        unit=$(ps -o unit= -p "$other" 2>/dev/null | tr -d ' ') || unit=
        [[ $unit == *.service && $unit != user@* ]] || unit=
        holders+=$'\n'"  $name (pid $other${unit:+, $unit})"
    done < <(ss -Hlunp '( sport = :500 or sport = :4500 )' 2>/dev/null |
        grep -o '("[^"]*",pid=[0-9]*' | sed 's/^("\(.*\)",pid=\(.*\)$/\2 \1/' | sort -un)
    if [[ -n $holders ]]; then
        die "another program is using UDP ports 500 and 4500, which the VPN needs.$holders"$'\n'"Stop it, then connect again."
    fi
    die "the VPN daemon couldn't open the UDP ports it needs (see: journalctl -u $SERVICE)"
}

cleanup() {
    # Release the helper if it is still waiting, or charon stays blocked on it.
    if [[ -n $fifo_open ]]; then
        printf '\n' >&3 || true
    fi
    if [[ -n $init_pid ]]; then
        kill "$init_pid" 2>/dev/null || true
    fi
    rm -f "$creds" "$FIFO" "$REQUEST" "$LOG"
    if [[ -n $connected ]]; then
        # Keep only the running tunnel; re-authenticating always needs a new code.
        "$SWANCTL" --load-creds --clear --noprompt --file "$SWAN_CONF" >/dev/null 2>&1 || true
    else
        drop_sa
        rm -f "$ACTIVE"
        systemctl stop "$SERVICE" || true
    fi
}

# Why signing in failed, as one word, from swanctl's log and the number of codes sent.
failure_reason() {
    local output=$1 codes_sent=$2
    case $output in
    *"rejecting EAP-Success"*) echo unproven-gateway ;;
    *AUTHENTICATION_FAILED*) echo final-auth ;;
    *EAP_FAILURE*) ((codes_sent > 0)) && echo wrong-code || echo wrong-password ;;
    *NO_PROPOSAL_CHOSEN*) echo proposals ;;
    *retransmit* | *"timed out"* | *timeout*) ((codes_sent > 0)) && echo code-timeout || echo no-answer ;;
    *) echo unknown ;;
    esac
}

# $2 is set when a code was rejected earlier in this attempt and cygnet signed in again.
explain_failure() {
    local reason=$1 retried=$2
    case $reason in
    unproven-gateway)
        echo "Stopped before sending a code: the gateway did not complete the password step"
        echo "as expected. Your code was not sent to it."
        ;;
    final-auth)
        echo "The gateway accepted your login but rejected the final IKE authentication."
        echo "This needs a settings change in $PREFIX/etc/strongswan.d/fortigate.conf."
        ;;
    wrong-code)
        echo "The gateway rejected the code: it was wrong or has expired."
        if [[ -n $retried ]]; then
            echo "New codes are only requested for $((CODE_RETRY_SECONDS / 60)) minutes after the first wrong one."
        fi
        ;;
    wrong-password)
        if [[ -n $retried ]]; then
            echo "This time the gateway rejected your password. After wrong codes, that can mean"
            echo "your account is locked for a while."
        else
            echo "The gateway rejected your password or username."
        fi
        ;;
    wrong-saved-password)
        echo "The gateway rejected the saved password, or the username. Cygnet has forgotten the"
        echo "password, so you'll be asked for it next time, and it's saved again once it works."
        ;;
    no-resolve)
        echo "The gateway's address couldn't be looked up. Check it, and your network."
        ;;
    proposals)
        echo "The gateway didn't accept the encryption proposals. Ask your VPN admin which"
        echo "IKE and ESP proposals it uses, and change them in the connection's settings."
        ;;
    code-timeout)
        echo "The gateway stopped answering. It probably gave up waiting for the code:"
        echo "its negotiate-timeout setting limits how long you have to enter it."
        ;;
    no-answer)
        echo "The gateway did not answer. Check your network and try again."
        ;;
    *)
        echo "The connection failed for an unrecognised reason."
        ;;
    esac
    echo "If you retry, use a new code. Repeated failures can lock your account."
}

# In --ui mode, a line or EOF on stdin while connecting means the GUI cancelled.
check_cancel() {
    local line
    if read -r -t 0; then
        IFS= read -r line || exit 130
        [[ $line != cancel ]] || exit 130
    fi
}

prompt_for_code() {
    local codes_sent=$1 retrying=$2 otp rc
    if [[ $codes_sent -gt 0 ]]; then
        say "The gateway asked again, so the last code was probably wrong."
    elif [[ -n $retrying ]]; then
        say "The gateway is now sending a new code."
    else
        say "Password accepted. The gateway is now sending your code."
    fi
    while :; do
        event need-code "$codes_sent"
        if [[ -n $ui ]]; then
            IFS= read -r -t "$CODE_PROMPT_TIMEOUT" otp || {
                rc=$?
                ((rc <= 128)) || die "timed out waiting for the code"
                exit 130
            }
        else
            read -rp "Enter the code: " -t "$CODE_PROMPT_TIMEOUT" otp || die "timed out waiting for the code"
        fi
        otp=$(trim "$otp")
        if [[ $otp =~ ^[0-9]{4,10}$ ]]; then
            printf '%s\n' "$otp" >&3
            return
        fi
        say "That doesn't look like a code: digits only."
    done
}

# Signs in with the password already loaded into charon, asking for a code each time the
# gateway wants one. Sets rc to swanctl's exit status and codes_sent to the number of codes
# sent. $1 is set when this is a sign-in again after a rejected code.
sign_in() {
    local retrying=$1
    rc=0 codes_sent=0
    rm -f "$REQUEST"
    "$SWANCTL" --initiate --child "$CONN" --ike "$CONN" --timeout "$INITIATE_TIMEOUT" >"$LOG" 2>&1 </dev/null &
    init_pid=$!

    while kill -0 "$init_pid" 2>/dev/null; do
        if [[ -e $REQUEST ]]; then
            rm -f "$REQUEST"
            prompt_for_code "$codes_sent" "$retrying"
            codes_sent=$((codes_sent + 1))
            say "Checking the code..."
            event checking
        else
            [[ -z $ui ]] || check_cancel
            sleep 0.2
        fi
    done
    wait "$init_pid" || rc=$?
    init_pid=
}

ipsec_connect() {
    local password output reason rc codes_sent retry_until=
    [[ -r $CONN_DIR/$id.psk ]] || die "the connection $c_name has no pre-shared key"
    # Checked first, as stopping the IPsec daemon after a failed attempt clears $ACTIVE.
    ! ssl_running || die "already connected to another VPN, or connecting; disconnect first"
    systemctl start "$SERVICE" || die "could not start $SERVICE (see: journalctl -u $SERVICE)"
    if is_up; then
        if [[ $(active_id) == "$id" ]]; then
            say "Already connected."
            event connected
            return
        fi
        die "already connected to another VPN; disconnect first"
    fi

    trap cleanup EXIT
    trap 'exit 130' INT TERM
    check_sockets
    drop_sa # left by an earlier failed attempt, or by a tunnel that has since dropped
    rm -f "$ACTIVE"

    write_swanctl_conf "$id"
    output=$("$SWANCTL" --load-conns --file "$SWAN_CONF" 2>&1) ||
        die "charon refused the connection settings: $output"

    event need-password "$c_username"
    if [[ -n $ui ]]; then
        IFS= read -r password || exit 130
    else
        IFS= read -rsp "Password for $c_username: " password
        echo
    fi
    [[ -n $password ]] || die "the password is empty"
    load_password "$password"
    unset password

    rm -f "$FIFO" "$REQUEST"
    mkfifo -m 600 "$FIFO"
    # Opened read-write, so writing never blocks even if the helper has gone away.
    exec 3<>"$FIFO"
    fifo_open=1

    say "Connecting to $c_name..."
    event connecting
    while :; do
        sign_in "$retry_until"
        if [[ $rc -eq 0 ]] && is_up; then
            connected=1
            printf '%s\n' "$id" >"$ACTIVE"
            chmod 644 "$ACTIVE"
            say "Connected."
            event connected
            [[ -n $ui ]] || status
            return
        fi

        output=$(cat "$LOG")
        reason=$(failure_reason "$output" "$codes_sent")
        # A wrong code ends the gateway's session. Signing in again makes it send a new code,
        # and the password is still loaded, so only the code has to be entered again.
        [[ $reason == wrong-code ]] || break
        retry_until=${retry_until:-$((SECONDS + CODE_RETRY_SECONDS))}
        ((SECONDS < retry_until)) || break
        say "The gateway rejected the code: it was wrong or has expired."
        say "Signing in again for a new code. To stop instead, press Ctrl+C."
        event code-rejected
        drop_sa
    done

    if [[ -n $ui ]]; then
        printf '%s\n' "$output" | tail -n 12 | sed 's/^/log /'
        explain_failure "$reason" "$retry_until" | sed 's/^/error /'
    else
        echo "$output" | tail -n 12
        echo
        explain_failure "$reason" "$retry_until"
    fi
    exit 1
}

connect() {
    local id
    pick "$1"
    load_conn "$id"
    if [[ $c_type == ssl ]]; then
        ssl_connect
    else
        ipsec_connect
    fi
}

# --- SSL tunnel --------------------------------------------------------------------------

ssl_state() {
    systemctl is-active "$SSL_SERVICE" 2>/dev/null || true
}

# Connected, or signing in.
ssl_running() {
    case $(ssl_state) in
    active | activating | deactivating | reloading) return 0 ;;
    esac
    return 1
}

# openfortivpn's config for the c_ connection, without the password.
ssl_write_conf() {
    {
        echo "# Written by cygnet for the connection $id. The password comes from ssl-pinentry."
        echo "host = $c_gateway"
        echo "port = $c_port"
        echo "username = $c_username"
        if [[ -n $c_trusted_cert ]]; then
            echo "trusted-cert = $c_trusted_cert"
        fi
    } >"$SSL_CONF"
}

# What openfortivpn logged in the service's latest run.
ssl_log() {
    local inv
    journalctl --sync >/dev/null 2>&1 || true
    inv=$(systemctl show --property InvocationID --value "$SSL_SERVICE" 2>/dev/null) || inv=
    [[ -n $inv ]] || return 0
    journalctl --quiet --no-pager --output cat "_SYSTEMD_INVOCATION_ID=$inv" 2>/dev/null || true
}

# Sets cert_subject, cert_issuer and cert_digest from openfortivpn's log, if it stopped
# because the system doesn't trust the gateway's certificate, or returns 1.
parse_untrusted_cert() {
    local line part=
    cert_subject= cert_issuer= cert_digest=
    [[ $1 == *"Gateway certificate validation failed"* ]] || return 1
    while IFS= read -r line; do
        line=$(trim "${line#ERROR:}")
        case $line in
        subject:) part=subject ;;
        issuer:) part=issuer ;;
        "sha256 digest:") part=digest ;;
        *)
            case $part in
            subject) cert_subject+=${cert_subject:+, }$line ;;
            issuer) cert_issuer+=${cert_issuer:+, }$line ;;
            digest)
                # It's printed again when signing out fails, so the first one is enough.
                cert_digest=$line
                break
                ;;
            esac
            ;;
        esac
    done <<<"$1"
    [[ $cert_digest =~ ^[0-9a-f]{64}$ ]]
}

# Shows the certificate from parse_untrusted_cert and asks whether to trust it from now on.
ask_trust() {
    local changed= answer
    [[ -z $c_trusted_cert ]] || changed=1
    if [[ -n $ui ]]; then
        event cert-subject "$cert_subject"
        event cert-issuer "$cert_issuer"
        event need-trust "$cert_digest" ${changed:+changed}
        IFS= read -r answer || exit 130
        [[ $answer == yes ]] || exit 130
        return
    fi
    if [[ -n $changed ]]; then
        echo "The gateway's certificate has changed since you trusted it. That's expected when"
        echo "it's renewed, but it could also mean that something is pretending to be the gateway."
    else
        echo "This computer can't verify the gateway's certificate, so it needs your OK once."
    fi
    echo "  subject: $cert_subject"
    echo "  issuer:  $cert_issuer"
    echo "  sha256:  $cert_digest"
    echo "If you can, check with your VPN admin that this is the gateway's certificate."
    ask answer "Trust it from now on? (yes/no)" "" check_yes_no
    [[ $answer == yes ]] || die "not connecting, as the gateway's certificate isn't trusted"
}

# Why signing in failed, as one word, from openfortivpn's log and the number of codes sent.
# The gateway only asks for a code once it has accepted the password.
ssl_failure_reason() {
    local output=$1 codes_sent=$2
    case $output in
    *"Could not authenticate to gateway"*) ((codes_sent > 0)) && echo wrong-code || echo wrong-password ;;
    *getaddrinfo:*) echo no-resolve ;;
    *"connect: "*) echo no-answer ;;
    *) echo unknown ;;
    esac
}

ssl_cleanup() {
    if [[ -n $init_pid ]]; then
        kill "$init_pid" 2>/dev/null || true
    fi
    if [[ -z $connected ]]; then
        # Before the tunnel is up, this ends openfortivpn at once, and ssl-pinentry with it.
        systemctl stop "$SSL_SERVICE" 2>/dev/null || true
    fi
    rm -f "$SSL_FIFO" "$SSL_REQUEST"
}

# Starts openfortivpn, and answers ssl-pinentry with the password and the codes you enter,
# until the tunnel is up or openfortivpn gives up. Sets rc to 0 once the tunnel is up, and
# codes_sent to the number of codes sent. $1 is set when this is a sign-in again after a
# rejected code.
ssl_sign_in() {
    local retrying=$1 request
    rc=0 codes_sent=0
    rm -f "$SSL_REQUEST"
    systemctl reset-failed "$SSL_SERVICE" 2>/dev/null || true
    # This returns once openfortivpn says the tunnel is up, or fails when it exits before.
    systemctl start "$SSL_SERVICE" >/dev/null 2>&1 </dev/null &
    init_pid=$!

    while kill -0 "$init_pid" 2>/dev/null; do
        if [[ -e $SSL_REQUEST ]]; then
            request=$(<"$SSL_REQUEST")
            rm -f "$SSL_REQUEST"
            if [[ $request == password ]]; then
                printf '%s\n' "$password" >&3
            else
                prompt_for_code "$codes_sent" "$retrying"
                codes_sent=$((codes_sent + 1))
                say "Checking the code..."
                event checking
            fi
        else
            [[ -z $ui ]] || check_cancel
            sleep 0.2
        fi
    done
    wait "$init_pid" || rc=$?
    init_pid=
}

ssl_connect() {
    local password output reason rc codes_sent saved= trusted= iface retry_until=
    local cert_subject cert_issuer cert_digest
    if ssl_is_up; then
        if [[ $(active_id) == "$id" ]]; then
            say "Already connected."
            event connected
            return
        fi
        die "already connected to another VPN; disconnect first"
    fi
    ! ssl_running || die "another connection attempt is in progress"
    # The IPsec daemon only runs while connected, or after its tunnel dropped.
    ! systemctl is-active --quiet "$SERVICE" || die "already connected to another VPN; disconnect first"
    rm -f "$ACTIVE"

    if has_saved_password "$id"; then
        password=$(<"$CONN_DIR/$id.password")
        saved=1
    else
        event need-password "$c_username"
        if [[ -n $ui ]]; then
            IFS= read -r password || exit 130
        else
            IFS= read -rsp "Password for $c_username: " password
            echo
        fi
        [[ -n $password ]] || die "the password is empty"
        password=$(check_password "$password" 2>&1) || die "$password"
    fi

    trap ssl_cleanup EXIT
    trap 'exit 130' INT TERM
    install -d -m 700 "$SSL_DIR"
    rm -f "$SSL_FIFO" "$SSL_REQUEST"
    mkfifo -m 600 "$SSL_FIFO"
    # Opened read-write, so writing never blocks even if the helper has gone away.
    exec 3<>"$SSL_FIFO"

    say "Connecting to $c_name..."
    event connecting
    while :; do
        ssl_write_conf
        ssl_sign_in "$retry_until"
        if [[ $rc -eq 0 ]] && ssl_is_up; then
            connected=1
            output=$(ssl_log)
            iface=
            if [[ $output =~ Interface\ ([^[:space:]]+)\ is\ UP ]]; then
                iface=${BASH_REMATCH[1]}
            fi
            printf '%s\n%s\n' "$id" "$iface" >"$ACTIVE"
            chmod 644 "$ACTIVE"
            if [[ $c_save_password == yes && -z $saved ]]; then
                write_secret "$CONN_DIR/$id.password" "$password"
                say "Saved the password for next time."
            fi
            say "Connected."
            event connected
            [[ -n $ui ]] || status
            return
        fi

        output=$(ssl_log)
        if parse_untrusted_cert "$output"; then
            # Trusted a moment ago, so something else is wrong with it.
            [[ $cert_digest != "$trusted" ]] || break
            ask_trust
            trusted=$cert_digest
            c_trusted_cert=$cert_digest c_password= c_psk=
            write_conn
            say "Trusted. Connecting..."
            event connecting
            continue
        fi
        reason=$(ssl_failure_reason "$output" "$codes_sent")
        # A wrong code ends the sign-in. Signing in again makes the gateway send a new code,
        # and the password is still at hand, so only the code has to be entered again.
        [[ $reason == wrong-code ]] || break
        retry_until=${retry_until:-$((SECONDS + CODE_RETRY_SECONDS))}
        ((SECONDS < retry_until)) || break
        say "The gateway rejected the code: it was wrong or has expired."
        say "Signing in again for a new code. To stop instead, press Ctrl+C."
        event code-rejected
    done
    unset password

    reason=${reason:-unknown}
    if [[ $reason == wrong-password && -n $saved && -z $retry_until ]]; then
        rm -f "$CONN_DIR/$id.password"
        reason=wrong-saved-password
    fi
    output=$(printf '%s\n' "$output" | grep -v '^$' | tail -n 12)
    if [[ -n $ui ]]; then
        printf '%s\n' "$output" | sed 's/^/log /'
        explain_failure "$reason" "$retry_until" | sed 's/^/error /'
    else
        echo "$output"
        echo
        explain_failure "$reason" "$retry_until"
    fi
    exit 1
}

# --- Both --------------------------------------------------------------------------------

disconnect() {
    if any_up; then
        say "Disconnected."
    else
        say "Not connected."
    fi
    if is_up; then
        "$SWANCTL" --terminate --ike "$CONN" --force --timeout 10 >/dev/null 2>&1 || true
    fi
    # openfortivpn takes its routes and DNS servers down as it stops.
    systemctl stop "$SSL_SERVICE" 2>/dev/null || true
    rm -f "$ACTIVE"
    systemctl stop "$SERVICE" || true
    event disconnected
}

status() {
    local id iface routes type=ipsec
    id=$(active_id)
    if [[ -n $id && -r $CONN_DIR/$id.conf ]]; then
        [[ $(conf_get "$CONN_DIR/$id.conf" type) != ssl ]] || type=ssl
    fi
    if is_up; then
        if [[ -r $CONN_DIR/$id.conf ]]; then
            echo "Connected to $(conf_get "$CONN_DIR/$id.conf" name)."
        fi
        "$SWANCTL" --list-sas --ike "$CONN"
    elif ssl_is_up; then
        if [[ -r $CONN_DIR/$id.conf ]]; then
            echo "Connected to $(conf_get "$CONN_DIR/$id.conf" name) (SSL VPN)."
        fi
        iface=$(sed -n 2p "$ACTIVE" 2>/dev/null) || iface=
        if [[ -n $iface ]]; then
            ip -4 address show dev "$iface" 2>/dev/null | sed -n 's/^ *inet /address /p'
            routes=$(ip -4 route show dev "$iface" 2>/dev/null) || routes=
            if [[ -n $routes ]]; then
                echo "networks through the VPN, set by the gateway:"
                printf '%s\n' "$routes" | sed 's/^/  /'
            fi
        fi
    elif [[ -e $ACTIVE ]]; then
        # Only a disconnect or the IPsec daemon stopping removes this file.
        echo "Not connected: the VPN dropped. Connecting again needs a new code."
        if [[ $type == ssl ]]; then
            echo "The reason is in: journalctl -u ${SSL_SERVICE%.service}"
        else
            echo "The reason is in: journalctl -u ${SERVICE%.service}"
        fi
    else
        echo "Not connected."
    fi
}

# --- Main --------------------------------------------------------------------------------

usage() {
    echo "usage:" >&2
    sed -n '4,10s/^#//p' "$(readlink -f "$0")" >&2
    exit 2
}

args=()
for arg; do
    case $arg in
    --ui) ui=1 ;;
    -h | --help) usage ;;
    -*) usage ;;
    *) args+=("$arg") ;;
    esac
done
cmd=${args[0]:-connect}
target=${args[1]:-}
case $cmd:${#args[@]} in
connect:[012] | disconnect:1 | status:1 | list:1 | add:1 | save:[12]) ;;
edit:2 | remove:2 | import:2) ;;
*) usage ;;
esac

# Listing only reads files that are readable by everyone.
if [[ $cmd != list && $EUID -ne 0 ]]; then
    exec sudo -- "$(readlink -f "$0")" "$@"
fi

case $cmd in
import) import_legacy "$target" ;;
*) "$cmd" "$target" ;;
esac
