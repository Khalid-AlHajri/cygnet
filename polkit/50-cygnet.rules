// Lets administrators who are signed in at this computer use Cygnet without an admin
// password prompt. This covers connecting, disconnecting and changing Cygnet's VPN
// connections, and nothing else. Delete this file to be asked every time instead.
polkit.addRule(function (action, subject) {
    if (action.id == "io.github.Khalid_AlHajri.Cygnet.manage" &&
        subject.local && subject.active &&
        (subject.isInGroup("wheel") || subject.isInGroup("sudo") || subject.isInGroup("admin"))) {
        return polkit.Result.YES;
    }
});
